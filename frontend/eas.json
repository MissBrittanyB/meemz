{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_META_APP_ID": "2826139691089206",
        "EXPO_PUBLIC_META_CLIENT_TOKEN": "a4e62e14bb22ed7a0ec434abb864c7ca"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_META_APP_ID": "2826139691089206",
        "EXPO_PUBLIC_META_CLIENT_TOKEN": "a4e62e14bb22ed7a0ec434abb864c7ca"
      }
    }
  }
}
