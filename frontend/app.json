{
  "expo": {
    "name": "meemz",
    "slug": "meemz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "meemz needs access to your photo library to upload memes and GIFs you want to share with the community.",
        "NSPhotoLibraryAddUsageDescription": "meemz saves animated memes to your camera roll so you can share them on social media with motion.",
        "NSCameraUsageDescription": "meemz uses your camera to take photos for your profile picture or to create new memes."
      },
      "bundleIdentifier": "app.emergent.memetypee1fc7ef9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA"
      ],
      "package": "com.emergent.memetype.vdjmku"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      "expo-web-browser",
      "react-native-iap",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
